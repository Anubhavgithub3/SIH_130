# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
backend/dist/
frontend/.next/
frontend/out/

# ── TypeScript build cache ────────────────────────────────────────────────────
tsconfig.tsbuildinfo
**/*.tsbuildinfo

# ── AI tool / Antigravity IDE files (not project code) ───────────────────────
.agents/
skills-lock.json

# ── Vercel config (deploying to Render instead) ───────────────────────────────
vercel.json

# ── env — never commit credentials ───────────────────────────────────────────
.env
.env.*
!.env.example
!**/.env.example
backend/.env*
frontend/.env*
!backend/.env.example
!frontend/.env.example

# ── Local document storage (LocalStorageAdapter) ──────────────────────────────
backend/uploads/

# ── Prisma local DB ──────────────────────────────────────────────────────────
backend/prisma/dev.db

# ── Logs ──────────────────────────────────────────────────────────────────────
npm-debug.log*
*.log

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
